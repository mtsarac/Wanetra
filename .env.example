WANETRA_DATA_PATH=/data
WANETRA_PORT=8080
WANETRA_BIND_ADDRESS=127.0.0.1
TZ=Europe/Istanbul

# Optional environment overrides. Any non-empty value locks the setting in the UI.
# WANETRA_AUTH=disabled   # disabled turns sign-in off, enabled forces it on, empty lets Settings decide
# DataRetention__Days=365
# Lan__Enabled=false            # true in compose.lan.yaml
# Lan__Cidr=192.168.1.0/24      # empty detects this machine's networks
# Lan__ScanIntervalMinutes=5
# Lan__OfflineAfterScans=3
# Lan__AlertOnNewDevice=true
# Probes__Enabled=true
# Probes__IntervalSeconds=10
# Probes__TimeoutMs=2000
# Probes__Outage__FailuresRequired=3
# Probes__Outage__RecoveriesRequired=3
# Probes__Retention__RawHours=48
# Probes__Retention__MinuteDays=30
# SpeedTest__Engine=librespeed
# SpeedTest__Ookla__AcceptLicense=false
# SpeedTest__Ookla__ExecutablePath=/usr/local/bin/speedtest
